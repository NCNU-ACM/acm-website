---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
---

<BaseLayout title={event.data.title}>
  <div class="max-w-3xl mx-auto px-8 py-16">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-sm px-2 py-1 rounded" style="background-color: var(--color-accent); color: white;">
        {event.data.type}
      </span>
      <span style="color: var(--color-text-muted);">
        {event.data.date.toLocaleDateString('zh-TW')}
      </span>
    </div>
    <h1 class="text-4xl font-bold mb-4">{event.data.title}</h1>
    {event.data.location && <p class="mb-4" style="color: var(--color-text-muted);">📍 {event.data.location}</p>}
    <p class="mb-8" style="color: var(--color-text-muted);">{event.data.description}</p>
    {event.data.registration && (
      <a href={event.data.registration} target="_blank"
         class="inline-block px-6 py-3 rounded font-medium mb-8"
         style="background-color: var(--color-accent); color: white;">
        前往報名
      </a>
    )}
    <div class="prose prose-invert">
      <Content />
    </div>
  </div>
</BaseLayout>