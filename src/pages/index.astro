---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.vue';
import GroupsSection from '../components/home/GroupsSection.vue';
import UpcomingEvents from '../components/home/UpcomingEvents.vue';
import EventReview from '../components/home/EventReview.vue';
import JoinSection from '../components/home/JoinSection.vue';
import { getCollection } from 'astro:content';

const allGroups = await getCollection('groups');
const groups = allGroups
  .filter(g => g.data.active)
  .sort((a, b) => a.data.order - b.data.order);

const allEvents = await getCollection('events');
const upcoming = allEvents
  .filter(e => e.data.status === 'upcoming')
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const past = allEvents
  .filter(e => e.data.status === 'past')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<BaseLayout title="首頁">
  <div id="fullpage">
    <div class="section"><HeroSection client:load /></div>
    <div class="section"><GroupsSection groups={groups.map(g => g.data)} client:load /></div>
    <div class="section">
      <UpcomingEvents events={upcoming.map(e => ({
        id: e.id,
        title: e.data.title,
        date: e.data.date.toLocaleDateString('zh-TW'),
        type: e.data.type,
      }))} client:load />
    </div>
    <div class="section">
      <EventReview events={past.map(e => ({
        id: e.id,
        title: e.data.title,
        date: e.data.date.toLocaleDateString('zh-TW'),
      }))} client:load />
    </div>
    <div class="section"><JoinSection client:load /></div>
  </div>
</BaseLayout>

<script>
  const sections = document.querySelectorAll('.section');
  let currentIndex = 0;
  let isScrolling = false;

  const goToSection = (index: number) => {
    if (index < 0 || index >= sections.length) return;
    currentIndex = index;
    sections[index].scrollIntoView({ behavior: 'smooth' });
    
    document.querySelectorAll('.nav-dot').forEach((dot, i) => {
      const d = dot as HTMLElement;
      if (i === currentIndex) {
        d.style.background = 'rgba(59,130,246,0.9)';
        d.style.transform = 'scale(1.3)';
      } else {
        d.style.background = 'rgba(255,255,255,0.3)';
        d.style.transform = 'scale(1)';
      }
    });
  };

  let wheelTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener('wheel', (e) => {
    e.preventDefault();
    if (isScrolling) return;
    
    isScrolling = true;
    if (e.deltaY > 0) {
      goToSection(currentIndex + 1);
    } else {
      goToSection(currentIndex - 1);
    }
    
    setTimeout(() => { isScrolling = false; }, 800);
  }, { passive: false });

  window.addEventListener('keydown', (e) => {
    if (isScrolling) return;
    if (e.key === 'ArrowDown') goToSection(currentIndex + 1);
    if (e.key === 'ArrowUp') goToSection(currentIndex - 1);
  });

  const nav = document.createElement('div');
  nav.style.cssText = 'position:fixed;right:1.5rem;top:50%;transform:translateY(-50%);z-index:100;display:flex;flex-direction:column;gap:0.75rem;';
  
  sections.forEach((_, i) => {
    const dot = document.createElement('div');
    dot.className = 'nav-dot';
    dot.style.cssText = `width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,0.3);cursor:pointer;transition:all 0.3s;`;
    if (i === 0) {
      dot.style.background = 'rgba(59,130,246,0.9)';
      dot.style.transform = 'scale(1.3)';
    }
    dot.addEventListener('click', () => goToSection(i));
    nav.appendChild(dot);
  });
  document.body.appendChild(nav);
</script>

<style>
  .section {
    height: 100vh;
    overflow: hidden;
  }
  html, body {
    overflow: hidden;
    height: 100%;
  }
  .nav-dot.active {
    background: rgba(59, 130, 246, 0.9) !important;
    transform: scale(1.3) !important;
  }
</style>