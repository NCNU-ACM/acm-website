---
import { getCollection } from 'astro:content';
import Navbar from '../components/common/Navbar.vue';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'NCNU ACM', 
  description = '國立暨南國際大學 ACM 社團' 
} = Astro.props;

const allGroups = await getCollection('groups');
const groups = allGroups
  .filter(g => g.data.active)
  .sort((a, b) => a.data.order - b.data.order)
  .map(g => ({ name: g.data.name, slug: g.data.slug }));
---

<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | NCNU ACM</title>
  </head>
  <body>
    <Navbar groups={groups} client:load />
    <main style="padding-top: var(--navbar-height);">
      <slot />
    </main>
    <footer style="border-top: 1px solid var(--color-border); padding: 2rem; text-align: center; color: var(--color-text-muted);">
      © 2024 NCNU ACM. All rights reserved.
    </footer>
  </body>
</html>